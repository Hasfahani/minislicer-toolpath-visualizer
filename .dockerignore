# Purpose: Excludes local caches, logs, screenshots, and build artifacts from Docker builds.
# Reason: Smaller Docker build contexts are faster and avoid copying private/generated files into images.
.git
.pytest_cache
.streamlit
.venv
__pycache__
*.pyc
*.pyo
*.pyd
*.log
.coverage
htmlcov
dist
build
*.egg-info
screenshots
docs/images/*.png
docs/images/*.jpg
docs/images/*.jpeg
docs/images/*.gif
