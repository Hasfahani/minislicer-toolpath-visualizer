# Purpose: Tells Git which local, generated, cache, and environment files to ignore.
# Reason: Keeps commits focused on source code, docs, tests, and intentional project assets.
# Python cache
__pycache__/
*.py[cod]
*.pyo
*.pyd

# Virtual environment
.venv/
venv/

# Test / coverage
.pytest_cache/
.coverage
htmlcov/
*.log
data/

# Streamlit
.streamlit/

# IDE
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db
